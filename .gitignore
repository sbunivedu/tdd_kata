# =========================================================================
# Maven (Build Artifacts)
# =========================================================================
# Ignore the entire target directory where Maven builds your .class and .jar files
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# =========================================================================
# Java (Compiled files & Logs)
# =========================================================================
*.class
*.log
*.ctxt
hs_err_pid*
replay_pid*

# =========================================================================
# VS Code (Workspace & Settings)
# =========================================================================
# Ignore user-specific workspace configurations and extensions cache
.vscode/
.code-workspace

# Optional: If you want to share launch configurations with your team, 
# uncomment the line below but keep specific user settings ignored
# !.vscode/launch.json

# =========================================================================
# Language Server / Eclipse Files (Generated by VS Code Java Extensions)
# =========================================================================
